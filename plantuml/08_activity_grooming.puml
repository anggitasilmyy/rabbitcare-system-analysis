@startuml
skinparam shadowing false
title Activity Diagram - Grooming dan Rabbit Care

|Pemilik Kelinci|
start
:Memilih profil kelinci;
:Memilih jenis grooming / rabbit care;
:Memilih jadwal;

|Sistem|
:Memeriksa ketersediaan groomer;
:Menyimpan booking dan mengirim konfirmasi;

|Admin / Resepsionis|
:Melakukan check-in;
:Memasukkan pasien ke antrean grooming;

|Groomer / Pet Care Staff|
:Melakukan pemeriksaan kondisi awal;
if (Aman untuk grooming?) then (Ya)
  :Melakukan layanan grooming;
  :Mencatat tindakan dan hasil grooming;
  if (Ada temuan kesehatan?) then (Ya)
    :Mencatat temuan;
    :Menyarankan pemeriksaan dokter;
  endif
  :Memberikan rekomendasi perawatan berikutnya;
  |Sistem|
  :Menyimpan riwayat grooming;
  :Membuat reminder grooming berikutnya;
  :Mengirim data layanan ke penagihan;
  stop
else (Tidak)
  :Menghentikan / menunda grooming;
  :Mencatat alasan layanan tidak dilakukan;
  :Menyarankan pemeriksaan dokter;
  |Sistem|
  :Mengubah status layanan menjadi "Ditunda";
  stop
endif
@enduml
