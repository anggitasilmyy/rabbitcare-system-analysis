@startuml
skinparam shadowing false
title Sequence Diagram - Payment Gateway and Verified Callback v1.1

actor "Pemilik Kelinci" as Owner
boundary "Owner Portal" as OUI
control "API Gateway" as API
control "Billing Service" as Billing
control "Payment Service" as PS
database "RabbitCare Database" as DB
participant "Payment Gateway Adapter" as Adapter
participant "Payment Gateway Provider" as PG
control "Receipt Service" as Receipt
control "Notification Service" as NS

Owner -> OUI : Buka invoice yang telah diterbitkan
Owner -> OUI : Pilih Bayar
OUI -> API : POST /api/payments + Idempotency-Key
API -> Billing : validateInvoiceOwnership(invoiceId, ownerContext)
Billing -> DB : read invoice, outstanding amount, currency
DB --> Billing : invoice data
Billing --> PS : initiatePayment(invoice, serverCalculatedAmount, key, payloadFingerprint)
PS -> DB : check idempotency key and active attempt

alt Same key and same payload already exists
  DB --> PS : existing payment attempt
  PS --> API : return existing attempt (no new checkout)
  API --> OUI : existing attempt + checkout/status
else Same key with different payload
  DB --> PS : key conflict
  PS --> API : 409 IDEMPOTENCY_KEY_CONFLICT
  API --> OUI : request rejected
else Active payment attempt already exists
  DB --> PS : active PENDING / uncertain attempt
  PS --> API : return active attempt or PAYMENT_ATTEMPT_IN_PROGRESS
  API --> OUI : current payment attempt status
else New valid request
  PS -> DB : insert Payment(status=PENDING, internalReference, key)
  DB --> PS : paymentId
  PS -> DB : COMMIT payment attempt
  PS -> Adapter : createCheckout(payment data)
  Adapter -> PG : create transaction / checkout
  PG --> Adapter : provider reference + checkout URL
  Adapter --> PS : provider response
  PS -> DB : save provider transaction reference
  PS --> API : payment attempt + checkout instructions
  API --> OUI : checkout response
  Owner -> PG : Complete payment on provider checkout
end

PG -> Adapter : POST callback / webhook
Adapter -> Adapter : verify signature / provider authentication
Adapter -> PS : process callback with verification result
PS -> DB : record callback event / check deduplication

alt Callback event already processed
  DB --> PS : duplicate event
  PS --> Adapter : acknowledge duplicate; no repeated side effects
else Callback invalid or reference/amount/currency mismatch
  PS -> DB : record verification exception only
  PS --> Adapter : reject / exception response
else Verified successful provider result
  PS -> DB : BEGIN + lock Payment and Invoice
  PS -> DB : check invoice settlement and payment state
  alt Invoice not yet paid
    PS -> DB : update Payment=PAID and Invoice=LUNAS
    PS -> DB : record event/audit + COMMIT
    PS -> Receipt : issueReceiptOnce(invoiceId, paymentId)
    Receipt -> DB : insert receipt with unique invoice/payment constraint
    DB --> Receipt : receipt reference / existing receipt
    Receipt --> PS : receipt reference
    PS -> NS : publish payment_completed (after commit)
    NS --> Owner : Notifikasi pembayaran berhasil
  else Invoice already paid by another attempt
    PS -> DB : mark additional successful attempt as exception
    PS -> DB : record event/audit + COMMIT
    PS --> Adapter : accepted; reconciliation required
    note right of PS
      Do not create a second receipt.
      Do not automatically refund without an approved policy.
    end note
  end
else Verified pending / failed / cancelled result
  PS -> DB : update allowed Payment status
  PS -> DB : keep Invoice BELUM_DIBAYAR unless already LUNAS
  PS -> DB : record event/audit + COMMIT
  PS --> Adapter : accepted / status recorded
end

Owner -> OUI : Check payment status / receipt
OUI -> API : GET /api/payments/{payment_id}
API -> PS : getPaymentStatus(ownerContext)
PS -> DB : query payment and receipt
DB --> PS : status + receipt if issued
PS --> API : payment result
API --> OUI : payment result

note over Adapter,PS
  A browser redirect is not proof of payment.
  Only a verified provider result can update Payment and Invoice.
  Callback processing must be idempotent.
end note
@enduml
